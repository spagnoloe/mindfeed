{
  "name": "mindfeed",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:contract": "pnpm --filter mobile test:contract && pnpm --filter @mindfeed/content test:contract",
    "seed:generate": "pnpm --filter @mindfeed/content seed:generate"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4"
  }
}
