# Copy to .env (git-ignored) and fill in. Values for local Supabase come from `supabase status` at the repo root.

# Emulator: the Android emulator reaches the Mac as 10.0.2.2.
# Physical phone on the same Wi-Fi: use the Mac's network IP, e.g. http://192.168.1.20:54321 (not localhost).
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321

# The "ANON_KEY" line printed by `supabase status -o env`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
